MODEL_VERSION=yolov8-paddleocr-indian-v1.0
YOLO_MODEL_PATH=models/yolo_plate.onnx
# Set to "mock" to skip real model loading in dev/test
INFERENCE_MODE=auto
# Confidence thresholds
CONF_HIGH=0.85
CONF_MEDIUM=0.60
# Voting buffer settings
VOTE_BUFFER_SIZE=10
VOTE_TIMEOUT_FRAMES=30
VOTE_MIN_READS=3
# Logging
LOG_LEVEL=INFO
