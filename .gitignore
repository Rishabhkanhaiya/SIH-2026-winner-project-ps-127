# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
.eggs/
dist/
build/
*.egg-info/
*.egg
node_modules/


# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables (never commit secrets)
.env
!.env.example

# Model files (too large for git; use Git LFS or separate storage)
service-a/models/*.onnx
service-a/models/*.pt
service-a/models/*.pth
service-a/models/*.pkl

# PaddleOCR inference cache
inference/
paddle_model/
~/.paddleocr/

# Test / coverage artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Jupyter notebooks output (if any)
*.ipynb_checkpoints/

# Temp extraction files
prd_extracted.txt
prd_chunk*.txt
prd_*.txt
